// Cloudflare Workers static-assets config (https://developers.cloudflare.com/workers/static-assets/).
// Cloudflare's git-connected deploy flow now runs `npx wrangler deploy` (it has
// absorbed the old standalone "Pages" project type) and needs this file to know
// what to serve. This project has no server-side Worker code — it's a pure
// static site — so there is no `main` entry point, only an `assets` directory.
{
  "name": "beatles-tone-lab",
  "compatibility_date": "2026-07-03",
  "assets": {
    "directory": "./"
  }
}
